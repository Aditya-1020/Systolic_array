`verilator_config
lint_off -rule SPECIFYIGN -file "*fakeram130_128x64.v"
lint_off -rule SPECIFYIGN -file "*fakeram130_128x64.sv"
lint_off -rule SPECIFYIGN -file "*fakeram130_256x64.sv"
lint_off -rule SPECIFYIGN -file "*fakeram130_512x64.sv"
lint_off -rule PINCONNECTEMPTY -file "*systolic_top.sv"
lint_off -rule SYNCASYNCNET -file "*systolic_top.sv"
lint_off -rule SYNCASYNCNET -file "*pp_buf_1r1w.sv"
lint_off -rule DECLFILENAME -file "*cells_clkgate_sim.v"
lint_off -rule DECLFILENAME -file "*cells_clkgate.v"
lint_off -rule DECLFILENAME -file "*fakeram130_256x64.sv"
lint_off -rule DECLFILENAME -file "*fakeram130_512x64.sv"
