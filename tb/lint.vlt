`verilator_config
// Generated SRAM macro model: specify block is for SDF only
lint_off -rule SPECIFYIGN -file "*fakeram130_128x64.v"
// o_done is intentionally unused at systolic_top level
lint_off -rule PINCONNECTEMPTY -file "*systolic_top.sv"
// Sync reads of reset below are inside `ifndef SYNTHESIS checks only
lint_off -rule SYNCASYNCNET -file "*systolic_top.sv"
lint_off -rule SYNCASYNCNET -file "*pp_buf_1r1w.sv"
